{
  "expo": {
    "name": "Owner Companion",
    "slug": "owner-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ownercompanion",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.owner.companion",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.owner.companion"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset"
    ]
  }
}
