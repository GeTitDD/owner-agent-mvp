{
  "name": "@owner/openclaw-owner-agent",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "OpenClaw feature plugin that surfaces Owner Agent jobs and frozen patch/sandbox/repair decisions",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.1"
  },
  "dependencies": {
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "openclaw": "2026.11.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.11.1"
    },
    "build": {
      "openclawVersion": "2026.11.1"
    }
  }
}
