{
  "name": "owner-agent-mvp",
  "version": "1.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "Owner-centric resident multi-project agent with composable knowledge workbench and opt-in Pi event capture",
  "author": "Owner Companion",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node bin/domainctl.mjs demo",
    "check": "node scripts/check-syntax.mjs",
    "demo:layered": "node examples/layered-demo.mjs",
    "workbench": "node bin/workbench.mjs",
    "owner": "node bin/ownerctl.mjs",
    "knowledge": "node bin/knowledgectl.mjs",
    "knowledge:demo": "node scripts/knowledge-loop/demo.mjs",
    "knowledge:eval": "node scripts/knowledge-loop/eval-real.mjs",
    "knowledge:eval:hard": "node scripts/knowledge-loop/eval-hard.mjs",
    "desktop": "electron desktop/main.cjs",
    "demo:owner": "node examples/owner-demo.mjs",
    "demo:jobs": "node examples/task-coordinator-demo.mjs",
    "demo:pi": "node examples/pi-worker-demo.mjs",
    "demo:patch": "node examples/patch-worker-demo.mjs",
    "demo:sandbox": "node examples/sandbox-demo.mjs",
    "demo:repair": "node examples/repair-demo.mjs",
    "acceptance:repair": "node scripts/acceptance/e2e-repair.mjs",
    "e2e:openclaw": "node scripts/e2e/openclaw-smoke.mjs",
    "e2e:openclaw:ui": "node scripts/e2e/openclaw-ui.mjs",
    "e2e:openclaw:p31": "node scripts/e2e/openclaw-ui-p31.mjs",
    "e2e:desktop": "node scripts/e2e/desktop-companion.mjs",
    "e2e:desktop:shell": "node scripts/e2e/desktop-shell.mjs",
    "e2e:desktop:sandbox-config": "node scripts/e2e/desktop-sandbox-config.mjs",
    "e2e:desktop:multiproject": "node scripts/e2e/desktop-multiproject.mjs",
    "e2e:desktop:knowledge": "node scripts/e2e/desktop-knowledge.mjs",
    "e2e:desktop:decisions": "node scripts/e2e/desktop-decisions.mjs",
    "test:sandbox:real": "node --test tests/sandbox-real.test.mjs",
    "desktop:dir": "electron-builder --win dir --x64",
    "desktop:pack": "electron-builder --win portable --x64",
    "knowledge:auto": "node scripts/knowledge-loop/auto-runtime.mjs",
    "observer": "node bin/observerctl.mjs",
    "knowledge:eval:ab": "node scripts/knowledge-loop/eval-ab-learning.mjs",
    "e2e:desktop:playbooks": "node scripts/e2e/desktop-playbooks.mjs",
    "e2e:desktop:harvest": "node scripts/e2e/desktop-knowledge-harvest.mjs",
    "e2e:desktop:composer": "node scripts/e2e/desktop-composer.mjs",
    "e2e:packaged:monty": "node scripts/e2e/monty-packaged-smoke.mjs",
    "e2e:desktop:mascots": "node scripts/e2e/desktop-mascots.mjs",
    "e2e:desktop:projects": "node scripts/e2e/desktop-projects.mjs",
    "e2e:desktop:card-shell": "node scripts/e2e/desktop-card-shell.mjs",
    "e2e:desktop:card-projects": "node scripts/e2e/desktop-card-projects.mjs",
    "e2e:desktop:sync-offline": "node scripts/e2e/desktop-sync-offline.mjs",
    "e2e:desktop:blocks": "node scripts/e2e/desktop-blocks.mjs",
    "e2e:desktop:copy-export": "node scripts/e2e/desktop-copy-export.mjs",
    "e2e:desktop:ops-proposals": "node scripts/e2e/desktop-ops-proposals.mjs",
    "e2e:desktop:focus-relocate": "node scripts/e2e/desktop-focus-relocate.mjs",
    "e2e:desktop:focus-entries": "node scripts/e2e/desktop-focus-entries.mjs",
    "e2e:desktop:ideas": "node scripts/e2e/desktop-idea-capture.mjs",
    "e2e:desktop:ideas-sort": "node scripts/e2e/desktop-idea-sort.mjs",
    "e2e:desktop:ideas-promote": "node scripts/e2e/desktop-idea-promote.mjs",
    "e2e:desktop:since-seen": "node scripts/e2e/desktop-since-last-seen.mjs",
    "e2e:desktop:library-export": "node scripts/e2e/desktop-library-export.mjs",
    "e2e:desktop:project-delete": "node scripts/e2e/desktop-project-delete.mjs",
    "e2e:desktop:library-feishu": "node scripts/e2e/desktop-library-feishu.mjs",
    "e2e:desktop:versions": "node scripts/e2e/desktop-library-versions.mjs",
    "e2e:desktop:write-scope": "node scripts/e2e/desktop-write-scope.mjs",
    "e2e:desktop:own-write": "node scripts/e2e/desktop-own-write.mjs",
    "e2e:desktop:risk-card": "node scripts/e2e/desktop-risk-card.mjs",
    "e2e:desktop:confirm-cards": "node scripts/e2e/desktop-confirm-cards.mjs",
    "cindy:pack": "node scripts/build-cindy-plugin.mjs owner-companion",
    "cindy:import": "node scripts/import-owner-data.mjs",
    "cindy:pack:relay": "node scripts/build-cindy-plugin.mjs cindy-relay",
    "e2e:desktop:slash": "node scripts/e2e/desktop-slash-panel.mjs",
    "e2e:desktop:at-menu": "node scripts/e2e/desktop-at-menu.mjs",
    "e2e:desktop:at-prompt": "node scripts/e2e/desktop-at-prompt.mjs",
    "e2e:desktop:at-session": "node scripts/e2e/desktop-at-session.mjs",
    "e2e:desktop:at-project": "node scripts/e2e/desktop-at-project.mjs",
    "e2e:desktop:project-write": "node scripts/e2e/desktop-project-write.mjs",
    "e2e:desktop:config-box": "node scripts/e2e/desktop-config-box.mjs"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.owner.companion",
    "productName": "Owner Companion",
    "asar": true,
    "files": [
      "desktop/**/*",
      "src/**/*",
      "web/**/*",
      "domains/**/*",
      "examples/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-companion"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "OwnerCompanion-${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/@pydantic/monty/**",
      "node_modules/@pydantic/monty-*/**"
    ]
  },
  "bin": {
    "domainctl": "./bin/domainctl.mjs",
    "ownerctl": "./bin/ownerctl.mjs",
    "knowledgectl": "./bin/knowledgectl.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@pydantic/monty": "^1.5.0",
    "mermaid": "^11.17.2",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jszip": "^3.10.2"
  }
}
